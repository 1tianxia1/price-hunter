# ============================================================
# PriceHunter 环境变量模板
# 使用方式：复制本文件为 .env（放在项目根目录），按需填入真实密钥。
#
# 全部变量均为「可选」：不填任何 Key 也能完整跑通（价格/券走演示数据，页面顶部有横幅提示），
# 历史价格在拿不到真实数据源时展示空态（不画假曲线），由自建本地库逐步累积真实数据。
#
# 已存在的系统环境变量优先级更高，不会被 .env 覆盖。
#
# 历史价格数据源优先级：自建本地库 -> 大淘客 -> 通用第三方 -> 空态
# ============================================================

# ---------- 服务配置（可选，均有默认值）----------
# 后端服务端口（Vite dev 会从同一个 .env 读取 PORT，自动把 /api 代理到该端口）
PORT=8787
# 后端监听地址
HOST=0.0.0.0
# 无真实历史数据时，是否生成模拟曲线用于演示。默认 false（展示空态，不画假曲线）
HISTORY_SIMULATE_ON_EMPTY=false

# ---------- 京东联盟 union.jd.com（可选，影响京东价格与券）----------
# 申请：京东联盟 -> 我的推广 -> API 权限 -> 创建应用
JD_APP_KEY=
JD_APP_SECRET=
# 可选：京东联盟推广位 ID（unionId）。不填不影响基础比价，仅部分推广接口需要
JD_UNION_ID=
# 可选：预留给 CPS 转链（本期明确不做转链），当前代码未使用
JD_PID=

# ---------- 阿里妈妈淘宝客 open.taobao.com（可选，影响淘宝/天猫价格与券）----------
# 申请：阿里妈妈 -> 推广管理 -> 媒体备案 -> 创建应用（选择「淘宝客」）
# 注：主用 TB_APP_KEY；旧命名 TAOBAO_APP_KEY 仍兼容，二者填其一即可
TB_APP_KEY=
TB_APP_SECRET=
# 可选：taobao.tbk.coupon.get 所需的授权串。不填则跳过优惠券查询（不影响价格比价）
TAOBAO_TBK_ME=
# 可选：预留给 CPS 转链（本期明确不做转链），当前代码未使用
TAOBAO_PID=

# ---------- 多多进宝 jinbao.pinduoduo.com（可选，影响拼多多价格与券）----------
# 申请：多多进宝 -> 开放平台创建应用
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
# 可选：推广位 PID，用于商品详情接口
PDD_PID=

# ---------- 大淘客开放平台 openapi.dataoke.com（可选，历史价格数据源之一）----------
# 接口：/api/goods/price-trend（商品历史券后价），官方文档标注免费自助接入
# 说明：大淘客只覆盖淘宝 / 天猫商品，京东 / 拼多多会自动跳过，交给后面的数据源
DATAOKE_APP_KEY=
DATAOKE_APP_SECRET=
# 可选：接口版本号，默认 v1.0.0
DATAOKE_VERSION=v1.0.0

# ---------- 通用第三方历史价接口（可选，慢慢买类，历史价第三级数据源）----------
# 注：CPS 联盟 API 均不含历史价格，历史价必须独立接源
HISTORY_API_BASE_URL=
HISTORY_API_KEY=
# 上游返回的价格单位：yuan（元，默认）或 cent（分）
HISTORY_PRICE_UNIT=yuan

# ---------- 自建本地历史价格库（可选，默认开启）----------
# 每次 /api/compare 成功后，把各平台券后价落盘；累积后即为真实价格曲线，不依赖任何第三方。
# 存储后端为「双通道」：
#   1) 部署到 EdgeOne Makers 时走平台 Blob 对象存储（命名空间 price-hunter，key 为 price-history.json）——
#      Serverless 容器的本地文件系统不可持久化，必须依赖 Blob 才能跨冷启动保留数据；
#   2) 本地 npm run dev / 未绑定 Blob 时自动降级为本地文件 server/data/price-history.json。
# 无需任何额外配置：Blob 命名空间首次写入时自动创建。设为 false 可整体关闭。
LOCAL_HISTORY_ENABLED=true

# ---------- Blob 存储连接信息（可选，通常留空）----------
# 以下两项仅在「从 Cloud Functions 之外」访问 Blob 时才需要（例如本地脚本批量导入历史价）。
# 正常部署 / 本地降级模式都不需要填写。
# EO_PROJECT_ID=
# EO_BLOB_TOKEN=
